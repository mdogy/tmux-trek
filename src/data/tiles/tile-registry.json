{
  "_doc": "Tile-type registry. The map grid stores single-char keys; a zone's `legend` maps each char to one of these tile keys. Semantics (walkable/sight/verbs) come from HERE, not from the art (StarCraft model: visual decoupled from mechanics). Categories follow FreeCiv's terrain-ruleset idea: each type carries a property table.",
  "_categories": {
    "void": "Off-map. Not part of the playable area; never walkable, never rendered as floor (StarCraft 'null terrain').",
    "wall": "Solid structure. Blocks movement and (unless transparent) line of sight.",
    "floor": "Walkable ground, indoor or outdoor.",
    "door": "Walkable threshold. Carries the `enter` verb; a zone `transition` or `location` entry says where it leads.",
    "obstruction": "Blocks movement but is not a built wall (water, fence). May still be transparent to sight."
  },
  "_verbs": {
    "look": "Examine. Returns the description of the most specific thing at the target (object > tile > location).",
    "enter": "Cross a door into a linked location or zone.",
    "talk": "Speak with an adjacent NPC (added dynamically, not stored on tiles).",
    "use": "Operate an interactive object (terminal/console).",
    "take": "Pick up an item.",
    "read": "Read a signpost/notice (guide hint)."
  },
